---
// src/pages/writing/[...id].astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import { getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection("writing", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <SiteNav current="/writing" />

  <main class="post">
    <a href="/writing" class="post__back">← All writing</a>
    <p class="post__date">{formatDate(post.data.date)}</p>
    <h1 class="post__heading">{post.data.title}</h1>

    <div class="post__body">
      <Content />
    </div>
  </main>
</BaseLayout>

<style>
  .post {
    max-width: 620px;
    margin: 0 auto;
    padding: 40px 24px 80px;
  }
  .post__back {
    display: inline-block;
    font-family: "Inter", sans-serif;
    font-size: 13px;
    color: var(--sage);
    text-decoration: none;
    margin-bottom: 32px;
    transition: color 0.15s ease;
  }
  .post__back:hover {
    color: var(--accent);
  }
  .post__date {
    font-family: "Inter", sans-serif;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 600;
    margin: 0 0 12px;
  }
  .post__heading {
    font-family: "Fraunces", serif;
    font-weight: 500;
    font-size: clamp(28px, 5vw, 40px);
    color: var(--cream);
    margin: 0 0 36px;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .post__body {
    font-family: "Fraunces", serif;
    font-size: 18px;
    line-height: 1.75;
    color: #e4ddc9;
  }
  .post__body :global(p) {
    margin: 0 0 22px;
  }
  .post__body :global(h2) {
    font-family: "Fraunces", serif;
    font-weight: 500;
    color: var(--cream);
    font-size: 26px;
    margin: 40px 0 16px;
  }
  .post__body :global(a) {
    color: var(--accent);
    text-decoration-color: var(--border-soft);
  }
  .post__body :global(blockquote) {
    border-left: 3px solid var(--accent);
    margin: 28px 0;
    padding-left: 20px;
    font-style: italic;
    color: var(--sage);
  }
  .post__body :global(img) { 
  width: 100%; 
  border-radius: 12px; 
  margin: 32px 0; 
  display: block;
  }
</style>
