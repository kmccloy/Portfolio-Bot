---
// src/components/LandingIntro.astro
// Sits above the chatbot on the homepage. Gives the site a proper front
// door — a real hero plus two doors out to About and Writing — so the
// chatbot reads as one part of the site, not the entire site.
---

<section class="landing">
  <p class="landing__eyebrow">Coach. Researcher. Builder.</p>
  <h1 class="landing__heading">Hi, I'm Kyle.</h1>
  <p class="landing__sub">
    I build coaching frameworks, programmes, and the occasional chatbot.
    Vancouver-raised, London-based, currently deep in an MSc in
    Psychotherapy Studies. 

  <br/> <br /> 
  I built the chatbot below so your wouldn't have to read a PDF - it's trained on my own words!
  </p>

  <div class="landing__cards">
    <a href="/about" class="landing__card">
      <span class="landing__card-label">The longer version</span>
      <span class="landing__card-title">About Me</span>
      <span class="landing__card-desc">
        Where I've been, what I've built, and what I'm looking for next.
      </span>
    </a>
    <a href="/writing" class="landing__card">
      <span class="landing__card-label">Notes & essays</span>
      <span class="landing__card-title">Writing</span>
      <span class="landing__card-desc">
        Thoughts on coaching, AI, and building things from scratch.
      </span>
    </a>
  </div>

  <p class="landing__divider">
    Or skip straight to the interesting part — ask me anything below.
  </p>
</section>

<style>
  .landing {
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 12px 24px 44px;
    text-align: center;
  }
  .landing__eyebrow {
    font-family: "Inter", sans-serif;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    margin: 0 0 16px;
  }
  .landing__heading {
    font-family: "Fraunces", serif;
    font-weight: 500;
    font-size: clamp(36px, 7vw, 56px);
    color: var(--cream);
    margin: 0 0 16px;
    letter-spacing: -0.01em;
  }
  .landing__sub {
    font-family: "Fraunces", serif;
    font-style: italic;
    font-size: 17px;
    color: var(--sage);
    max-width: 460px;
    margin: 0 auto 36px;
    line-height: 1.6;
  }
  .landing__cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    text-align: left;
    margin-bottom: 32px;
  }
  .landing__card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: var(--panel);
    border-radius: 14px;
    padding: 20px 22px;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .landing__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -12px rgba(0, 0, 0, 0.4);
  }
  .landing__card-label {
    font-family: "Inter", sans-serif;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
  }
  .landing__card-title {
    font-family: "Fraunces", serif;
    font-weight: 500;
    font-size: 21px;
    color: var(--ink-green);
  }
  .landing__card-desc {
    font-family: "Inter", sans-serif;
    font-size: 13px;
    color: #5c6b57;
    line-height: 1.5;
  }
  .landing__divider {
    font-family: "Inter", sans-serif;
    font-size: 13px;
    color: var(--footer-text);
    margin: 0;
  }

  @media (max-width: 560px) {
    .landing__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
