---
// src/components/SiteNav.astro
// Small, quiet nav — the site's real content should carry attention,
// not the nav bar. Current page gets the accent color, nothing else moves.

const { current = "" } = Astro.props;

const links = [
  { href: "/", label: "Chat with me" },
  { href: "/about", label: "About" },
  { href: "/writing", label: "Writing" },
];
---

<nav class="site-nav">
  <a href="/" class="site-nav__mark">Kyle McCloy</a>
  <div class="site-nav__links">
    {
      links.map((link) => (
        <a
          href={link.href}
          class:list={["site-nav__link", { "is-current": current === link.href }]}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .site-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 760px;
    margin: 0 auto;
    padding: 28px 24px 0;
    font-family: "Inter", sans-serif;
  }
  .site-nav__mark {
    font-family: "Fraunces", serif;
    font-weight: 500;
    font-size: 16px;
    color: var(--cream);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .site-nav__links {
    display: flex;
    gap: 22px;
  }
  .site-nav__link {
    font-size: 13px;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--sage);
    transition: color 0.15s ease;
  }
  .site-nav__link:hover {
    color: var(--cream);
  }
  .site-nav__link.is-current {
    color: var(--accent);
  }

  @media (max-width: 480px) {
    .site-nav {
      flex-direction: column;
      gap: 14px;
      align-items: flex-start;
      padding-top: 22px;
    }
  }
</style>
